         update statistics will be collected on this training example
         """
         row_vector,col_vector =  self.clip_and_quantize_update_matrix_inputs(row_vector, col_vector)
+
+        # [La-Sc patch] Fast path: an outer-product update leaves every row with a zero input
+        # untouched (target dw = 0 -> lookup-table update and its write noise are both exactly 0),
+        # so only rows with nonzero input are sent through the device model. Same result, ~5x less
+        # work on MNIST where ~80 % of pixels are 0. Used only where it is provably equivalent.
+        if (self.params.numeric_params.update_model==UpdateModelEnum.DG_LOOKUP
+                and not (self.params.numeric_params.Rp > 0 and self.params.numeric_params.parasitic_backprop)
+                and self.params.numeric_params.Nex_par == 1 and not self.record_updates
+                and not self.params.numeric_params.useGPU
+                and not self.params.numeric_params.dG_lookup.multi_LUT
+                and not self.params.numeric_params.dG_lookup.Nlevels > 0):
+            rows = np.flatnonzero(row_vector)
+            if len(rows) == 0:
+                return
+            sub_w = self.matrix[rows]
+            sub_dw = np.outer(row_vector[rows]*learning_rate, col_vector)
+            sub_upd = self.params.numeric_params.dG_lookup.compute_update(sub_dw, sub_w)
+            sub_w = sub_w + sub_upd
+            self.matrix[rows] = self.xbar_params.weights.quantize(self.xbar_params.weight_clipping.clip(sub_w))
+            return
+
         if self.params.numeric_params.Rp > 0 and self.params.numeric_params.parasitic_backprop:
             # Calculate outer product update in the presence of parasitics (experimental feature!!)
             update = self.calc_OPU_parasitics(row_vector*learning_rate,col_vector)
