+		elif not self.slow_interpolator and not self.gpu_engaged and not disable_nonlinearity:
+			# [La-Sc patch] vectorised single-LUT update, algebraically identical to the branch below:
+			#   update = (dw/ave_dw) * ave_dw(w) + dw_error(CDF, w) * sqrt(dw/ave_dw)
+			# Indices are clamped into the table (fixes the IndexError 101 crash at the table edges).
+			pos = dw > 0
+			wmin_c = self.param_root.xbar_params.weight_clipping.minimum
+			nW = self.ave_dw_inc_vec.shape[0]
+			w_step = (self.w_vec[-1] - self.w_vec[0]) / (nW - 1)
+			wi = ((w - (wmin_c - w_step/2)) / w_step).astype(np.intp)
+			np.clip(wi, 0, nW - 1, out=wi)
+			mean = np.where(pos, self.ave_dw_inc_vec[wi], self.ave_dw_dec_vec[wi])
+			scale = dw / np.where(pos, self.ave_dw_inc, self.ave_dw_dec)
+			update = scale * mean
+			if not disable_writenoise:
+				nC = self.dw_error_matrix_inc.shape[0]
+				CDF_step = (self.CDF_vec[-1] - self.CDF_vec[0]) / (nC - 1)
+				ci = ((np.random.random_sample(w.shape) + CDF_step/2) / CDF_step).astype(np.intp)
+				np.clip(ci, 0, nC - 1, out=ci)
+				flat = ci * nW + wi
+				err = np.where(pos, self.dw_error_matrix_inc.ravel()[flat], self.dw_error_matrix_dec.ravel()[flat])
+				update += err * np.sqrt(np.maximum(scale, 0.0))
